<Window x:Class="WpfPlaylist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPlaylist"
        mc:Ignorable="d"
        Title="WPF Playlist" Height="430" Width="650">
    <Grid x:Name="grdMain" Background="AntiqueWhite">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="lbxSongs" Margin="10" SelectionChanged="LbxSongs_SelectionChanged" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnPlay" IsEnabled="False" Content="PLAY" Padding="10,5" Margin="10" Click="BtnPlay_Click"/>
            <Button x:Name="btnStop" IsEnabled="False" Content="STOP" Padding="10,5" Margin="10" Click="BtnStop_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <Slider x:Name="sldVolume" Maximum="100" Minimum="0" TickFrequency="5" Value="50" IsSnapToTickEnabled="True" Margin="10,5" ValueChanged="SldVolume_ValueChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,0">
                <TextBlock Margin="10,0" TextWrapping="Wrap" Text="Volume:" />
                <TextBlock x:Name="txtVolume" TextWrapping="Wrap" Text="50" />
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" x:Name="txtMessage" Text="" FontStyle="Italic" FontSize="16" HorizontalAlignment="Left" Margin="10" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1" Grid.RowSpan="4">
            <Border BorderBrush="LightGray" BorderThickness="1" Background="#fff9f9f9" Margin="10">
                <Image x:Name="imgArtist" Height="200" Width="200"/>
            </Border>
            <TextBlock Grid.Column="1" Grid.Row="1" x:Name="txtArtist" Margin="10" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
