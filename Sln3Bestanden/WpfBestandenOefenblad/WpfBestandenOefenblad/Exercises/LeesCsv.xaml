<Page x:Class="WpfBestandenOefenblad.Exercises.LeesCsv"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfBestandenOefenblad.Exercises"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LeesCsv">

    <Grid Background="#eeeeee">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>
        <Border Background="White">
            <!-- XAML VAN DE OEFENING -->

            <Grid Background="#E0E9FF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Button x:Name="btnLaad" Grid.Row="0" Content="Laad verkoopcijfers" Margin="10" Padding="8,4" HorizontalAlignment="Left" Click="btnLaad_Click"/>
                
                <ListBox x:Name="lstVerkoopcijfers" Grid.Row="1" Margin="10" FontFamily="Consolas"/>
                
                <TextBlock x:Name="txtTotaal" Grid.Row="2" Margin="10" FontWeight="Bold"/>

            </Grid>
            
        </Border>
    </Grid>
</Page>
