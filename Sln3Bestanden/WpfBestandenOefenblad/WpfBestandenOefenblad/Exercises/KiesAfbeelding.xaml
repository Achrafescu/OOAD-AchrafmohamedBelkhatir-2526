<Page x:Class="WpfBestandenOefenblad.Exercises.KiesAfbeelding"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfBestandenOefenblad.Exercises"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="KiesAfbeelding">

    <Grid Background="#eeeeee">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>
        <Border Background="White">
            <!-- XAML VAN DE OEFENING -->
            <StackPanel Margin="20" Background="AliceBlue" MaxWidth="600">
                <TextBlock x:Name="tblKies" Text="Kies een afbeelding:" Margin="10"/>
                <Button x:Name="btnKiesAfbeelding" Content="Kies afbeelding" Margin="10" Padding="8,4" HorizontalAlignment="Left" Click="btnKiesAfbeelding_Click"/>
                <Image x:Name="imgAfbeelding" Margin="10" MaxHeight="300"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
