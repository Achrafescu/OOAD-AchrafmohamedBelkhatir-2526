<Page x:Class="WpfBestandenOefenblad.Exercises.SchrijfTekst"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfBestandenOefenblad.Exercises"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SchrijfTekst">

    <Grid Background="#eeeeee">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>
        <Border Background="White">
            <!-- XAML VAN DE OEFENING -->

            <StackPanel Margin="20" Background="AliceBlue" MaxWidth="600">
                <Label Content="Tekst:" Margin="10"/>
                <TextBox x:Name="txtInhoud" Margin="10" Padding="4,2" TextWrapping="Wrap" AcceptsReturn="True" Height="200"
                         Text="Dit is een testbestand. Je kunt hier elke tekst plaatsen die je wilt. Probeer maar eens!" />
                <Button x:Name="btnSchrijfTekst" Content="Opslaan..." Margin="10" Padding="8,4"
                        HorizontalAlignment="Left" Click="btnSchrijfTekst_Click"/>
            </StackPanel>

        </Border>
    </Grid>
</Page>
