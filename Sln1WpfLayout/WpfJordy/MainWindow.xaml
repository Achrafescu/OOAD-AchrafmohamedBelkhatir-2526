<Window x:Class="WpfJordy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfJordy"
        mc:Ignorable="d"
        Title="MainWindow" Height="Auto" Width="760" MinWidth="400">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F5F5DC">
                <Image Source="./img/logo.png" HorizontalAlignment="Left" Stretch="Uniform" MaxWidth="120" Margin="20"/>
            </Border>
            <TextBlock Text="red Jordy" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontStyle="Italic" FontFamily="Rockwell" FontWeight="Bold"/>
            <Button BorderThickness="0" Content="LOGIN" Grid.Row="0" Grid.Column="0" Padding="8,3" HorizontalAlignment="Right" Margin="10" VerticalAlignment="Top"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Background="White" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" >
                <WrapPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
                    <Border Padding="5">
                        <Image Source="./img/jordy1.jpg" HorizontalAlignment="Left" Stretch="UniformToFill" Height="120" Width="160"/>
                    </Border>
                    <Border Padding="5">
                        <Image Source="./img/jordy2.jpg" HorizontalAlignment="Left" Stretch="UniformToFill" Height="120" Width="160" />
                    </Border>
                    <Border Padding="5">
                        <Image Source="./img/jordy3.jpg" HorizontalAlignment="Left" Stretch="UniformToFill" Height="120" Width="160" />
                    </Border>
                    <Border Padding="5">
                        <Image Source="./img/jordy4.jpg" HorizontalAlignment="Left" Stretch="UniformToFill" Height="120" Width="160" />
                    </Border>
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Padding="10" TextWrapping="Wrap">
                        <Run FontWeight="Bold"> Naam: </Run> Jordy
                        <LineBreak/>
                        <Run FontWeight="Bold"> Leeftijd: </Run> 6 maanden
                        <LineBreak/>
                        <Run FontWeight="Bold">Geslacht: </Run> mannetje
                        <LineBreak/>
                        <Run FontWeight="Bold"> Gewicht: </Run> 12kg
                    </TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" Padding="10" TextWrapping="Wrap">
                        Hallo, ik ben Jordy! Ik hou van wandelen, kinderen en huisdieren.
                        Ad veertien er al slaagden resident.
                        Waaronder eindelijk shatkist mee men wat britschen visschers.
                        Is om te markten streken en vrouwen.
                    </TextBlock>
                </Grid>

                    <Grid HorizontalAlignment="Center" MaxWidth="400" Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="16" Text="Wordt Jordy jouw nieuw maatje? Stuur hem een bericht!" FontStyle="Italic" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                        <Label Grid.Row="1" Grid.Column="0" Margin="0,1,0,1" Content="Naam:" FontWeight="Bold" Grid.ColumnSpan="2"/>
                        <TextBox Grid.Row="2" Grid.Column="0" Margin="0,5" Text="jouw naam" Opacity="0.5" BorderBrush="LightBlue" Grid.ColumnSpan="2" HorizontalContentAlignment="Left" />

                        <Label Grid.Row="3" Grid.Column="0" Content="Straat:" Margin="0,1,0,1" FontWeight="Bold" Grid.ColumnSpan="2"/>
                        <TextBox Grid.Row="4" Grid.Column="0" Text="jouw straat" Opacity="0.5" BorderBrush="LightBlue" Height="30" HorizontalContentAlignment="Left" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="5" Grid.Column="0" Margin="0,0,0,1" Content="Postcode:" FontWeight="Bold"/>
                        <TextBox Grid.Row="6" Grid.Column="0" Margin="0,5,10,5" Text="b.b 2500" Opacity="0.5" BorderBrush="LightBlue"/>

                        <Label Grid.Row="5" Grid.Column="1" Margin="0,0,0,1" Content="Gemeente:" FontWeight="Bold"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="10,5,0,5" Text="b.v Lier" Opacity="0.5" BorderBrush="LightBlue"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="Bericht:" FontWeight="Bold" Margin="0,1,0,1" Grid.ColumnSpan="2"/>
                        <TextBox Grid.Row="8" Grid.Column="0" Text="Ik wil Jordy adopteren!" BorderBrush="LightBlue" Opacity="0.5" Height="80" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10" Grid.ColumnSpan="2"/>

                        <Button Grid.Row="9" Grid.Column="1" BorderThickness="0" Content="VERZENDEN" Padding="8,3" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="Beige">
                <TextBlock Text="© 2024, verbond van dakloze dieren" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontFamily="Rockwell"/>
            </Border>
        </Grid>
    </Grid>
</Window>
