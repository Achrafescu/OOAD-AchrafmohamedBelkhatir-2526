<Page x:Class="WpfLayoutUIOefenblad.Exercises.NotepadApp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfLayoutUIOefenblad.Exercises"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="NotepadApp">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#6B6CB0" BorderThickness="1" Margin="40" MaxHeight="350">
            <!-- TODO: PAS HIERONDER DE XAML AAN -->
            <DockPanel LastChildFill="True">
                <!-- top menu -->
                <Menu DockPanel.Dock="Top">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" />
                        <MenuItem Header="_Open..." />
                        <MenuItem Header="_Save" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="E_xit" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_Check for updates" />
                        <MenuItem x:Name="mitAbout" Header="_About" Click="MitAbout_Click" />
                    </MenuItem>
                </Menu>
                <!-- status bar -->
                <StatusBar DockPanel.Dock="Bottom">
                    <StatusBarItem FontSize="8">
                        <TextBlock Text="bestand: Tekst1.txt" />
                    </StatusBarItem>
                    <StatusBarItem FontSize="8" HorizontalAlignment="Right">
                        <TextBlock Text="encoding: utf-8" />
                    </StatusBarItem>
                </StatusBar>
                <!-- content -->
                <TabControl>
                    <TabItem Header="Tekst1.txt">
                        <ScrollViewer>
                            <TextBox TextWrapping="Wrap" AcceptsReturn="True" Text="Hier staat tekst 1" Padding="5"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Untitled.txt">
                        <ScrollViewer>
                            <TextBox TextWrapping="Wrap" AcceptsReturn="True" Text="Hier staat weer andere tekst" Padding="5"/>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</Page>
