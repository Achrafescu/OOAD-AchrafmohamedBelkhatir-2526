<Window x:Class="WpfLayoutUIOefenblad.Exercises.NotepadAppAbout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLayoutUIOefenblad.Exercises"
        mc:Ignorable="d"
        Title="About WPF Notepad" Height="250" Width="250" ResizeMode="NoResize">
    <Grid Margin="20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Source="/Assignments/img/odisee-logo.png" Width="100"/>
        <Border Grid.Row="1" BorderThickness="0,1" BorderBrush="Black" Margin="0,5">
            <TextBlock Height="50" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center">
                WPF NotePad 1.0 
                <LineBreak/>
                <LineBreak/>
                <Run FontSize="8">Ontwikkeld door Safi Harare. Alle rechten voorbehouden.</Run>
            </TextBlock>
        </Border>
        <Button Grid.Row="2" HorizontalAlignment="Right" Content="Close" Padding="8,3" Margin="5" Name="btnClose" Click="BtnClose_Click" />
    </Grid>
</Window>
