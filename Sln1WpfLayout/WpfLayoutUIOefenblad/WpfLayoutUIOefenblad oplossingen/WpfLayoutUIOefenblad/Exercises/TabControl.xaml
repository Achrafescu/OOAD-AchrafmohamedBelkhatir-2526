<Page x:Class="WpfLayoutUIOefenblad.Exercises.TabControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfLayoutUIOefenblad.Exercises"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="TabControl">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#EEFDEF" BorderBrush="#6B6CB0" BorderThickness="1" Padding="12" Margin="20">
            <!-- TODO: PAS HIERONDER DE XAML AAN -->
            <TabControl Margin="20">
                <TabItem Header="Account">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="E-mail:" VerticalContentAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,10"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="Wachtwoord:" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <PasswordBox Grid.Row="1" Grid.Column="1" Height="30"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="Wijzigen" Padding="8,3" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Voorkeuren">
                    <StackPanel Margin="10">
                        <CheckBox Content="Nieuwsbrief ontvangen" Margin="0,0,0,10" IsChecked="True"/>
                        <CheckBox Content="Donkere modus" Margin="0,0,0,10" IsChecked="True"/>
                        <CheckBox Content="Meldingen toestaan"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Over" IsSelected="True">
                    <TextBlock Margin="10" TextWrapping="Wrap">
                        Dit is een voorbeeldapplicatie om TabControl te oefenen. Gebruik tabs om instellingen <Run FontWeight="Bold">logisch te groeperen</Run> en het scherm overzichtelijk te houden.
                        <LineBreak/>
                        <LineBreak/>
                        Safi Harare, 2026.
                    </TextBlock>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
