<Page x:Class="WpfLayoutUIOefenblad.Exercises.StackPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfLayoutUIOefenblad.Exercises"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="StackPanel">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#EEEFFD" BorderBrush="#6B6CB0" BorderThickness="1" Padding="12" Margin="20">
            <!-- TODO: PAS HIERONDER DE XAML AAN -->
            <Grid VerticalAlignment="Top" MaxWidth="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Label Content="Postcode:" Padding="0,5" Margin="0, 10, 0, 0" FontWeight="Bold" />
                    <TextBox Padding="5,0" Text="5330" BorderBrush="LightBlue" Height="30" VerticalContentAlignment="Center" />
                    <TextBlock Foreground="#666" FontStyle="Italic" TextAlignment="Right" FontSize="10" Padding="5">b.v. 1234</TextBlock> 
                </StackPanel>
                <StackPanel Margin="20, 0, 0, 0" Grid.Column="1">
                    <Label Content="Gemeente:" Padding="0,5" Margin="0, 10, 0, 0" FontWeight="Bold"  />
                    <TextBox Padding="5,0" Text="Poilvache" BorderBrush="LightBlue" Height="30" VerticalContentAlignment="Center" />
                    <TextBlock Foreground="#666" FontStyle="Italic" TextAlignment="Right" FontSize="10" Padding="5">b.v. Lier</TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
