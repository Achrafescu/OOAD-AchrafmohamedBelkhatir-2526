<Window x:Class="WpfLayoutUIOefenblad.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLayoutUIOefenblad"
        mc:Ignorable="d"
        Title="About WPF Notepad" 
        Height="250" Width="400" 
        MinHeight="250" MinWidth="400" 
        MaxHeight="450" MaxWidth="800" 
        ResizeMode="NoResize" 
        WindowStyle="ToolWindow">

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="20">
            <Border BorderBrush="#FFF" BorderThickness="5" Margin="5" Background="#F5F5F5" CornerRadius="5">
                <Image Source="/Assignments/img/odisee-logo.png" Width="80"/>
        </Border>

            <TextBlock Padding="10" TextWrapping="Wrap" TextAlignment="Center" FontSize="14">
                       WPF NotePad 1.0
					  <LineBreak/>
					  <LineBreak/>
					  Ontwikkeld door Safi Harare.
                      <LineBreak/>
                      Alle rechten voorbehouden. 2026.
            </TextBlock>
            
            <Button Content="Sluiten" 
                Click="BtnClose_Click" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom" 
                Width="80" 
                Height="30" 
                Margin="10"/>
        </StackPanel>
    </Grid>
</Window>