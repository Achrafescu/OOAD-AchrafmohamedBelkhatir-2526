<Page x:Class="WpfLayoutUIOefenblad.Exercises.NotepadApp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfLayoutUIOefenblad.Exercises"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="NotepadApp">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#6B6CB0" BorderThickness="1" Margin="40" MaxHeight="350">
            <!-- TODO: PAS HIERONDER DE XAML AAN -->
			
			<DockPanel LastChildFill="True"> <!-- LastChildFill: laatste element vult resterende middenruimte -->
			   <Menu DockPanel.Dock="Top">
				  <MenuItem Header="_File">
					 <MenuItem Header="_New" />
					 <MenuItem Header="_Open..." />
					 <MenuItem Header="_Save" />
					 <MenuItem Header="Save _As..." />
					 <Separator />
					 <MenuItem Header="E_xit" Click="ExitItem_Click" />
				  </MenuItem>
				  <MenuItem Header="_Help">
					 <MenuItem Header="Check for updates" />
					 <MenuItem Header="_About" Click="_About_Click"/>
				  </MenuItem>
			   </Menu>
			   
				<StatusBar DockPanel.Dock="Bottom">
					<StatusBarItem>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" 
									   Text="bestand: Tekst1.txt" 
									   FontSize="10" 
									   VerticalAlignment="Center" 
									   Margin="10,5"/>
							<TextBlock Grid.Column="1" 
									   Text="encoding: utf-8" 
									   FontSize="10" 
									   VerticalAlignment="Center" 
									   Margin="0,5,10,5"/>
						</Grid>
					</StatusBarItem>
				</StatusBar> 

			   	<TabControl SelectedIndex="0" >

				   <TabItem Header="Tekst1.txt" Padding="10,5">
				   	<ScrollViewer>
					  <TextBox AcceptsReturn="True" TextWrapping="Wrap" Padding="10" MinHeight="200">Hier staat tekst 1...</TextBox>
					 </ScrollViewer>
				   </TabItem>
				   <TabItem  Header="Untitled.txt" Padding="10,5">
				   	<ScrollViewer>
					  <TextBox AcceptsReturn="True" TextWrapping="Wrap" Padding="10" MinHeight="200">Hier staat tekst 2...</TextBox>
					 </ScrollViewer>
				   </TabItem>
				</TabControl>
				
			</DockPanel>

        </Border>
    </Grid>
</Page>
