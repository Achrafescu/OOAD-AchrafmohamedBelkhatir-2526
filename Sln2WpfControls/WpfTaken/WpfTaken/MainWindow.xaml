<Window x:Class="WpfTaken.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTaken"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="grdMain">
        <Label x:Name="lblTaak" Content="Taak:" HorizontalAlignment="Left" Margin="55,67,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblPrioriteit" Content="Prioriteit:" HorizontalAlignment="Left" Margin="55,109,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.501,0.518"/>
        <Label x:Name="lblDeadline" Content="Deadline:" HorizontalAlignment="Left" Margin="55,159,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.051,0.394"/>
        <Label x:Name="lblDoor" Content="Door:" HorizontalAlignment="Left" Margin="55,203,0,0" VerticalAlignment="Top"/>
       
        <TextBox x:Name="tbxTaak" HorizontalAlignment="Left" Margin="140,71,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="176" TextChanged="tbxTaak_TextChanged"/>
        
        <Button x:Name="btnToevoegen" Content="TOEVOEGEN &gt;&gt;" HorizontalAlignment="Left" Margin="228,246,0,0" VerticalAlignment="Top" Width="88" Height="30" Padding="1" Click="btnToevoegen_Click"/>

        <Button x:Name="btnTerug" Content="TERUGZETTEN" HorizontalAlignment="Left" Margin="400,304,0,0" VerticalAlignment="Top" Width="104" Height="30" IsEnabled="False" Click="btnTerug_Click"/>
        <Button x:Name="btnVerwijder" Content="VERWIJDEREN" HorizontalAlignment="Left" Margin="544,304,0,0" VerticalAlignment="Top" Height="30" Width="104" IsEnabled="False" Click="btnVerwijder_Click"/>


        <ComboBox x:Name="lbxPrioriteit" HorizontalAlignment="Left" Height="26" Margin="140,109,0,0" VerticalAlignment="Top" Width="176" SelectedIndex="0" SelectionChanged="lbxPrioriteit_SelectionChanged" >
            <ComboBoxItem Content="selecteer..."/>
            <ComboBoxItem Content="laag"/>
            <ComboBoxItem Content="gemiddeld"/>
            <ComboBoxItem Content="hoog"/>
        </ComboBox>


        <DatePicker x:Name="dpDeadline" HorizontalAlignment="Left" Height="26" Margin="140,159,0,0" VerticalAlignment="Top" Width="176" SelectedDateChanged="dpDeadline_SelectedDateChanged"/>

        <RadioButton x:Name="rdbAdam" Content="Adam" HorizontalAlignment="Left" Height="13" Margin="140,0,0,0" VerticalAlignment="Center" Width="51" GroupName="group1"/>
        <RadioButton x:Name="rdbBilal" Content="Bilal" HorizontalAlignment="Left" Height="13" Margin="200,0,0,0" VerticalAlignment="Center" Width="45" GroupName="group1"/>
        <RadioButton x:Name="rdbChelsey" Content="Chelsey" HorizontalAlignment="Left" Height="13" Margin="260,0,0,0" VerticalAlignment="Center" Width="66" GroupName="group1"/>
        
        <TextBlock x:Name="tblFoutmelding" HorizontalAlignment="Left" Height="92" Margin="55,304,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="261"/>
        
        <ListBox x:Name="lbxList" HorizontalAlignment="Left" Height="205" Margin="349,71,0,0" VerticalAlignment="Top" Width="428" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Multiple"/>

    </Grid>
</Window>
