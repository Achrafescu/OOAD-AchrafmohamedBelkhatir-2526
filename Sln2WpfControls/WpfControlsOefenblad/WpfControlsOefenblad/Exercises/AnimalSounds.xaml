<Page x:Class="WpfControlsOefenblad.Exercises.AnimalSounds"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfControlsOefenblad.Exercises"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AnimalSounds">

    <Grid Background="#eeeeee">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Exercises/Images/cat.png" 
                       Tag="Exercises/Sounds/cat.wav" 
                       Margin="20" Width="100" Height="100" 
                       MouseEnter="Image_MouseEnter"/>

                <Image Source="/Exercises/Images/chicken.png" 
                       Tag="Exercises/Sounds/chicken.wav" 
                       Margin="20" Width="100" Height="100" 
                       MouseEnter="Image_MouseEnter"/>

                <Image Source="/Exercises/Images/cow.png" 
                       Tag="Exercises/Sounds/cow.wav" 
                       Margin="20" Width="100" Height="100" 
                       MouseEnter="Image_MouseEnter"/>

                <Image Source="/Exercises/Images/horse.png" 
                       Tag="Exercises/Sounds/horse.wav" 
                       Margin="20" Width="100" Height="100" 
                       MouseEnter="Image_MouseEnter"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>