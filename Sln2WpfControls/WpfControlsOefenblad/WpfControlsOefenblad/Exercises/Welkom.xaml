<Page x:Class="WpfControlsOefenblad.Exercises.Welkom"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfControlsOefenblad.Exercises"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BasicTextBox">

    <Grid Background="#eeeeee">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White">
            <!-- HIERONDER BEGINT XAML VAN DE OEFENING -->
            <Grid Margin="20" MaxWidth="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Label x:Name="lblNaam" Grid.Row="0" Grid.Column="0" Content="Naam:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                
                <TextBox x:Name="txtNaam" Grid.Row="1" Grid.Column="0" Text="" Margin="0,0,5,10" Padding="5"/>
                
                <Button x:Name="btnZegHallo" Grid.Row="1" Grid.Column="1" Content="Zeg Hallo" Width="80" Margin="0,0,0,10" Click="Click_btnZegHallo"/>
                
                <TextBlock x:Name="tblFoutmelding" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Foreground="#900" Visibility="Hidden" FontStyle="Italic" Text="gelieve een naam in te vullen" FontSize="14" Margin="0,5,0,0"/>
                
                <TextBlock x:Name="tblResultaat" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="..." FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="Black"/>
                

            </Grid>
        </Border>
    </Grid>
</Page>
