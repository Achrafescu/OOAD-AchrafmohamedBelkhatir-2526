<Page x:Class="WpfControlsOefenblad.Exercises.LanguageSelector"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfControlsOefenblad.Exercises"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LanguageSelector">

    <Grid Background="#eeeeee">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White">
            <!-- HIERONDER BEGINT XAML VAN DE OEFENING -->
            <StackPanel Margin="40,25,40,25">
                <TextBlock Text="Selecteer je taal:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox x:Name="cbTaal" Width="200" SelectionChanged="cbTaal_SelectionChanged">
                </ComboBox>
                <TextBlock x:Name="txtGeselecteerdeTaal" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
