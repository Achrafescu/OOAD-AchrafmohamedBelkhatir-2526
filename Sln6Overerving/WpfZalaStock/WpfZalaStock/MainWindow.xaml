<Window x:Class="WpfZalaStock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfZalaStock"
        mc:Ignorable="d"
        Title="MainWindow" Height="850" MinHeight="500" MaxHeight="1000" Width="1400" MinWidth="800" MaxWidth="1800">
    <Grid>
        <DockPanel LastChildFill="True">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Image x:Name="imgLogo"
                       Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="2"
                        Height="100" Width="300" Source="/content/zala.jpg"
                       HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <!-- Categorie -->
                <Label x:Name="lblCategorie" 
                       Grid.Column="0" Grid.Row="2"
                       Content="Categorie:" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox x:Name="cbxCategorie" SelectedIndex="0"
                         Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                         Height="30" Margin="0,5" Width="200"
                         HorizontalAlignment="Center" SelectionChanged="cbxCategorie_SelectionChanged"
                         VerticalContentAlignment="Center" >
                    <ComboBoxItem Content="Alle" />
                    <ComboBoxItem Content="Kleding"/>
                    <ComboBoxItem Content="Schoenen"/>
                    <ComboBoxItem Content="Sieraden"/>
                </ComboBox>

                <!-- Beschikbare producten -->
                <Label x:Name="lblBeschikbareProducten"
                       Grid.Column="0" Grid.Row="3"
                       Content="Beschikbare producten:" FontWeight="Bold"
                       VerticalAlignment="Bottom" Margin="0,5"/>

                <Border Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Grid.RowSpan="2" Height="180" Width="400" Margin="1,5,1,5" BorderBrush="#FF6900" BorderThickness="3">
                    <ListBox x:Name="lstBeschikbareProducten"
                         Grid.Column="1" Grid.Row="1" Height="180" Width="400"
                         Margin="0,5" SelectionMode="Single"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center" SelectionChanged="lstBeschikbareProducten_SelectionChanged"/>
                </Border>

                <!-- Productdetails -->
                <Label x:Name="lblProductdetails"
                       Grid.Column="2" Grid.Row="2"
                       Content="Productdetails:" FontWeight="Bold"
                       VerticalAlignment="Bottom" Margin="0,5"/>
                <TextBlock x:Name="tblProductdetails"
                            Grid.Column="2" Grid.Row="3"
                            Height="30" Margin="0,5"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left" Width="180" TextWrapping="Wrap" Text="Selecteer een product..."/>

                <!-- Aantal -->
                <Label x:Name="lblAantal" FontWeight="Bold"
                       Grid.Column="2" Grid.Row="4"
                       Content="Aantal:"
                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5"/>
                <TextBox x:Name="txtAantal"
                         Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="2"
                         Height="30" Width="250" Margin="0,5"
                         HorizontalAlignment="Stretch" 
                         VerticalContentAlignment="Center"/>

                <!--- Button Verkopen -->
                <Button x:Name="btnVerkopen"
                        Grid.Column="2" Grid.Row="5"
                        Content="Verkopen" Background="#FF6900" Foreground="White"
                        Height="30" Width="150" Margin="0,5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center" Click="btnVerkopen_Click"/>

                <!--- Button Retourneren -->
                <Button x:Name="btnRetourneren"
                        Grid.Column="3" Grid.Row="5"
                        Content="Retourneren" Background="#FF6900" Foreground="White"
                        Height="30" Width="150" Margin="0,5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center" Click="btnRetourneren_Click"/>

                <!-- Verkocht -->
                <Label x:Name="lblVerkocht"
                       Grid.Column="4" Grid.Row="2"
                       Content="Verkocht:" FontWeight="Bold"
                       VerticalAlignment="Bottom" Margin="0,5"/>
                <Border Grid.Column="4" Grid.Row="3" Grid.ColumnSpan="2" Height="80" Width="300" Margin="1,5,1,5" BorderBrush="#FF6900" BorderThickness="3">
                    <ListBox x:Name="lstVerkochtProducten"
                         Grid.Column="4" Grid.Row="3" Height="80" Width="300"
                         Margin="1,5,1,5"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"/>
                    </Border>

                <!-- Geretourneerd -->
                <Label x:Name="lblGeretourneerd"
                       Grid.Column="4" Grid.Row="4"
                       Content="Geretourneerd:" FontWeight="Bold"
                       VerticalAlignment="Bottom" Margin="0,5"/>
                <Border Grid.Column="4" Grid.Row="5" Grid.ColumnSpan="2" Height="80" Width="300" Margin="1,5,1,5" BorderBrush="#FF6900" BorderThickness="3">
                    <ListBox x:Name="lstGeretourneerdProducten"
                         Grid.Column="4" Grid.Row="5" Height="80" Width="300"
                         Margin="1,5,1,5"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"/>
                </Border>

                <!-- Totalen -->
                <StackPanel Grid.Column="5" Grid.Row="6" Margin="0,5">
                    <TextBlock x:Name="tblTotaalVerkopen" Text="Totaalbedrag verkopen:" FontWeight="Bold"
                         Grid.Column="5" Grid.Row="6"
                         Height="30" Margin="0,5"
                         HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="tblTotaalRetours" Text="Totaalbedrag retours:" FontWeight="Bold"
                         Grid.Column="5" Grid.Row="6"
                         Height="30" Margin="0,5"
                         HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="tblTotaal" Text="Totaalbedrag:" FontWeight="Bold"
                         Grid.Column="5" Grid.Row="6"
                         Height="30" Margin="0,5"
                         HorizontalAlignment="Stretch"/>
                </StackPanel>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
